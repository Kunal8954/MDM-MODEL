# ==============================================================================
# SATGUARD PLATFORM SECURE ENVIRONMENT CONFIGURATION
# Phase 0 Template: DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COPERNICUS DATA SPACE ECOSYSTEM (CDSE)
# Register at: https://dataspace.copernicus.eu/
# Generate OAuth2 credentials in User Dashboard -> Profile -> OAuth Clients
# ------------------------------------------------------------------------------
CDSE_CLIENT_ID=your_cdse_oauth_client_id_here
CDSE_CLIENT_SECRET=your_cdse_oauth_client_secret_here

# S3 Direct Access Credentials (Generated in User Dashboard -> S3 Access)
CDSE_S3_ACCESS_KEY=your_cdse_s3_access_key_here
CDSE_S3_SECRET_KEY=your_cdse_s3_secret_key_here
CDSE_S3_ENDPOINT_URL=https://eodata.dataspace.copernicus.eu

# ------------------------------------------------------------------------------
# 2. NASA EARTHDATA LOGIN (For NASA GPM / IMERG Precipitation)
# Register at: https://urs.earthdata.nasa.gov/
# IMPORTANT: In your account profile, approve "NASA GES DISC DATA ARCHIVE" application
# ------------------------------------------------------------------------------
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_PASSWORD=your_nasa_earthdata_password

# ------------------------------------------------------------------------------
# 3. NASA FIRMS (Fire Information for Resource Management System)
# Request free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/
# ------------------------------------------------------------------------------
FIRMS_MAP_KEY=your_32_char_firms_map_key_here

# ------------------------------------------------------------------------------
# 4. GROQ CLOUD LPU INFERENCE (Evidence Synthesis & SITREP Generation)
# Generate API Key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=mixtral-8x7b-32768

# ------------------------------------------------------------------------------
# 5. OPENSTREETMAP (OSM)
# Public Overpass/Nominatim require no key, but require an identifiable User-Agent
# ------------------------------------------------------------------------------
OSM_USER_AGENT=SATGUARD-GeoIntelligence/1.0 (satguard-monitoring@domain.gov)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ------------------------------------------------------------------------------
# 6. DATABASE & SPATIAL ENGINE (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_USER=satguard_admin
POSTGRES_PASSWORD=change_this_secure_database_password
POSTGRES_DB=satguard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 7. LOCAL / CLOUD OBJECT STORAGE (MinIO or AWS S3 for GeoTIFF Rasters & Masks)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local_s3 # Options: 'local_s3', 'minio', 'aws_s3'
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minio_access_key
STORAGE_SECRET_ACCESS_KEY=minio_secret_key
STORAGE_BUCKET_NAME=satguard-products
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 8. APPLICATION RUNTIME & LOGGING
# ------------------------------------------------------------------------------
SATGUARD_ENV=development # Options: 'development', 'staging', 'production'
LOG_LEVEL=INFO
BANDWIDTH_OPTIMIZATION_ENABLED=true
MAX_PARALLEL_DOWNLOADS=4

# ------------------------------------------------------------------------------
# 9. PHASE 10 — SECURITY, AUTH & API HARDENING
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_char_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://satguard.gov.in
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
AUDIT_LOGGING_ENABLED=true
EXTERNAL_TIMEOUT_SECONDS=45

# Frontend Backend Connection
VITE_API_URL=http://localhost:8000
